# Copy to .env and fill in. `llm-gateway serve` loads ./.env automatically
# (with plain uvicorn, pass --env-file .env). Nothing here is required for the
# offline demo: `llm-gateway demo` needs no key at all.

# --- Upstream provider keys -------------------------------------------------
# NVIDIA NIM (default). Free key in ~2 minutes at https://build.nvidia.com
# It starts with "nvapi-". Without it, requests fail over to the next provider
# in routing.yaml (e.g. a local Ollama) instead of erroring.
NVIDIA_API_KEY=nvapi-XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX

# Optional additional OpenAI-compatible upstreams (only needed if you route to them).
# Ollama ignores the value; providers.yaml already supplies a default.
OLLAMA_API_KEY=ollama
# OPENAI_API_KEY=sk-XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
# TOGETHER_API_KEY=XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX

# --- Models -----------------------------------------------------------------
# Embedding model used by the semantic cache (a model id from providers.yaml).
# local/hash is a built-in offline embedder: no provider, no network.
EMBED_MODEL=nvidia/nv-embedqa-e5-v5

# --- Config file locations (defaults sit next to the app) -------------------
# CONFIG_DIR=.
# PROVIDERS_FILE=providers.yaml
# ROUTING_FILE=routing.yaml
# KEYS_FILE=keys.yaml
# PRICING_FILE=pricing.json
# GATEWAY_DB=gateway.db

# --- Cache ------------------------------------------------------------------
CACHE_ENABLED=true
SEMANTIC_CACHE_ENABLED=true
CACHE_TTL_SECONDS=86400
# Cosine similarity a query must reach to reuse a cached answer (0-1).
CACHE_SIMILARITY_THRESHOLD=0.92
# Oldest rows are evicted beyond this many cache entries (0 = no cap), and
# expired rows are purged every CACHE_PURGE_INTERVAL_SECONDS.
CACHE_MAX_ENTRIES=10000
CACHE_PURGE_INTERVAL_SECONDS=300

# --- Reliability ------------------------------------------------------------
# Retries per target for 5xx/408/429/timeouts. 401/403/404 and a missing
# provider key fail over at once; 400/413/422 are returned to the caller.
MAX_RETRIES_PER_TARGET=2
BACKOFF_BASE_SECONDS=0.5
# Also the longest upstream Retry-After the gateway will wait for.
BACKOFF_CAP_SECONDS=8
REQUEST_TIMEOUT_SECONDS=60
# Skip a target after this many consecutive failures, probe it again after the
# cooldown. 0 disables the circuit breaker.
BREAKER_FAILURE_THRESHOLD=5
BREAKER_COOLDOWN_SECONDS=30

# --- Auth -------------------------------------------------------------------
# When true, callers must present a valid virtual key from keys.yaml.
REQUIRE_AUTH=true
# Protects /admin/usage, /admin/health and /admin/reload (sent as the
# X-Admin-Token header). If unset, those endpoints are open (dev only).
# ADMIN_TOKEN=change-me

# LOG_LEVEL=INFO
